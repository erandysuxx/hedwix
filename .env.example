# Copiar a .env y cambiar las contraseñas (openssl rand -hex 16)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=cambiar
HEDWIX_APP_PASSWORD=cambiar
HEDWIX_MCP_PASSWORD=cambiar
# Desde los contenedores el host es "mongo". Desde la máquina (funnel con su .venv) usar 127.0.0.1
MONGODB_URI=mongodb://hedwix_app:cambiar@mongo:27017/hedwix?authSource=hedwix
# El MCP usa el usuario de sólo lectura hedwix_mcp
MCP_MONGODB_URI=mongodb://hedwix_mcp:cambiar@mongo:27017/hedwix?authSource=hedwix
